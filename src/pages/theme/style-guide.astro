---
import { Icon } from 'astro-icon/components';
import {
	TextCardSection,
	Container,
	Button,
	FormInput,
	FormSelect,
	FormTextarea,
} from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'Astro Odyssey 主题风格指南',
	description: '了解如何设置和使用这个 Astro 主题。',
};

const selectOptions = ['选项 1', '选项 2', '选项 3'];
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>风格指南</h1>
			<p>
				这是 <a
					href="https://github.com/treefarmstudio/odyssey-theme"
					target="_blank"
					rel="noopener noreferrer">Odyssey 主题</a
				>的风格指南。您在主题起始仓库中找到的所有内容要么来自<a
					href="https://www.npmjs.com/package/@components/odyssey-theme"
					target="_blank"
					rel="noopener noreferrer">Odyssey 组件包</a
				>，要么是使用组件构建的。这不仅允许一个完全模块化的设置，能够随着时间的推移接收更新和改进，而且还允许您根据需要零散地使用这些部分，以 Odyssey 为基础创建您自己独特的网站。
			</p>
		</TextCardSection>
		<section class="style-guide__section">
			<div class="style-guide__title-container">
				<h2>色彩</h2>
			</div>
			<div>
				<div class="style-guide-color__card">
					<h3>主色</h3>
				</div>
				<div class="style-guide-color__card style-guide-color__card--surface-1">
					<h3>表面色 1</h3>
				</div>
				<div class="style-guide-color__card style-guide-color__card--surface-2">
					<h3>表面色 2</h3>
				</div>
			</div>
		</section>
		<section class="style-guide__section">
			<div class="style-guide__title-container">
				<h2>排版</h2>
			</div>
			<div>
				<h1>一级标题</h1>
				<h2>二级标题</h2>
				<h3>三级标题</h3>
				<h4>四级标题</h4>
				<h5>五级标题</h5>
				<h6>六级标题</h6>
				<p>正文文本</p>
				<blockquote>
					“不要满足于生活给予你的；让生活更美好，去创造一些东西。” — 阿什顿·库彻
				</blockquote>
			</div>
		</section>
		<section class="style-guide__section">
			<div class="style-guide__title-container">
				<h2>按钮</h2>
			</div>
			<div>
				<p>普通按钮</p>
				<p>
					<Button>按钮 1</Button>
				</p>
				<p>无阴影按钮</p>
				<p>
					<Button unelevated>按钮 2</Button>
				</p>
				<p>线框按钮</p>
				<p>
					<Button outlined>按钮 3</Button>
				</p>
				<p>带自定义图标的按钮</p>
				<Button customIcon
					>启动页面
					<Fragment slot="icon">
						<Icon name="ic:baseline-launch" />
					</Fragment>
				</Button>
			</div>
		</section>
		<section class="style-guide__section">
			<div class="style-guide__title-container">
				<h2>表单</h2>
			</div>
			<div class="style-guide-forms__container">
				<div>
					<h3>带标签的输入框</h3>
					<FormInput type="text" label="姓名" name="Name" placeholder="张三"
					/>
				</div>
				<div>
					<h3>无标签输入框</h3>
					<FormInput type="text" name="Name" placeholder="张三" />
				</div>
				<div>
					<h3>选择下拉框</h3>
					<FormSelect options={selectOptions} />
				</div>
				<div>
					<h3>文本区域</h3>
					<FormTextarea name="Message" placeholder="在此输入您的消息..." />
				</div>
			</div>
		</section>
	</Container>
</Layout>

<style>
	.style-guide__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
	}
	.style-guide__title-container h2 {
		position: sticky;
		top: 0;
	}
	.style-guide-forms__container {
		display: grid;
		gap: 1rem;
	}
	.style-guide-forms__container h3 {
		margin-bottom: 0.5rem;
	}
	.style-guide-color__card {
		margin-bottom: 1rem;
		background-color: var(--theme-primary);
		color: var(--theme-on-primary);
		padding: 1rem;
		border-radius: var(--theme-shape-radius);
	}
	.style-guide-color__card--surface-1 {
		background-color: var(--theme-surface-1);
		color: var(--theme-on-surface-1);
	}
	.style-guide-color__card--surface-2 {
		background-color: var(--theme-surface-2);
		color: var(--theme-on-surface-2);
	}
	@media (max-width: 768px) {
		.style-guide__section {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>