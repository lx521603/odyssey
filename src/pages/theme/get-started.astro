---
import {Icon} from 'astro-icon/components';
import { Button, Container, TextCardSection } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: '开始使用 Rich',
	description: '了解如何设置和使用这个 Astro 主题。',
};
---

<Layout {seo}>
	<Container>
		<TextCardSection>
			<h1>开始使用 Rich</h1>
			<div class="cta-buttons__container">
        <Button
        href="https://rich.yt"
        outlined
        newTab
        customIcon
        >
        获取 Rich 主题
        <Fragment slot="icon">
          <Icon name="ic:baseline-launch" />
        </Fragment>
      </Button>
        <Button
					href="/theme/theme-setup"
          customIcon
					>
          主题设置
          <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right" />
          </Fragment>
				</Button>
        <Button
					href="/theme/customizing-odyssey"
          customIcon
					>
          自定义 Rich
          <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right" />
          </Fragment>
				</Button>
			</div>
		</TextCardSection>
	</Container>
</Layout>

<style>
	.cta-buttons__container {
		display: flex;
		flex-wrap: wrap;
	}
	.cta-buttons__container :global(a) {
    margin-right: 1rem;
		margin-bottom: 1rem;
	}
</style>