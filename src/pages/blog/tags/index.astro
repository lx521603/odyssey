---
// 使用别名导入
import PageLayout from "@/layouts/Page.astro"; 
import { generateTagData } from '@/utils/helpers.js'; 
import { getCollection } from "astro:content";

const posts = await getCollection("post");

// 收集所有唯一的标签
const allTags = new Set<string>();
posts.forEach(post => {
  if (post.data.tags && ArrayArray.isArray(post.data.tags)) {
    post.data.tags.forEach(tag => {
      const trimmedTag = tag.trim();
      if (trimmedTag) {
        allTags.add(trimmedTag);
      }
    });
  }
});

// 使用 generateTagData 生成可用于 URL 的 slug
const allTagsData = generateTagData(allTags);

// 计算每个标签的文章数量
const tagsWithCount = allTagsData.map(tagItem => {
  // 用于计数的标签需要标准化 (实现大小写不敏感计数)
  const tagToMatch = tagItem.title.trim().toLowerCase();

  const count = posts.filter(post => 
    post.data.tags && 
    Array.isArray(post.data.tags) && 
    // 过滤时，对比 post 中的标准化标签
    post.data.tags.some(postTag => postTag.trim().toLowerCase() === tagToMatch)
  ).length;

  return { ...tagItem, count };
}).filter(tagItem => tagItem.count > 0); // 只显示有文章的标签

const seo = {
	title: '标签列表 | Astro Odyssey Theme',
	description: '博客所有文章的标签列表。',
};
---

<PageLayout {seo}>
  <div class="relative site-container z-20 w-full mx-auto mt-8 px-4 md:mt-10 lg:mt-12 xl:px-0">
    <div class="text-center mb-12">
      <h1 class="text-5xl font-bold mb-4 tracking-tight text-gray-900 dark:text-gray-50">所有标签</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        共找到 {tagsWithCount.length} 个活跃标签。点击查看相关文章。
      </p>
    </div>

    <section class="max-w-4xl mx-auto">
      <ul class="flex flex-wrap gap-4 justify-center">
        {tagsWithCount.map(tag => (
          <li>
            <a 
              href={`/blog/tags/${tag.slug}`} 
              class="inline-block px-4 py-2 text-sm font-semibold rounded-full bg-blue-100 text-blue-800 hover:bg-blue-200 transition duration-150 ease-in-out dark:bg-blue-900 dark:text-blue-200 dark:hover:bg-blue-800"
            >
              {tag.title} ({tag.count})
            </a>
          </li>
        ))}
      </ul>
    </section>

    {tagsWithCount.length === 0 && (
      <div class="text-center text-gray-500 dark:text-gray-400 py-12">
        <p>目前还没有任何标签。</p>
      </div>
    )}
  </div>
</PageLayout>

