---
// 使用别名导入，确保路径解析最稳定
import PageLayout from "@/layouts/Page.astro"; 
import FeatureCard from "@/components/cards/FeatureCard.astro"; 
import { generateTagData } from '@/utils/helpers.js'; 
import { getCollection } from "astro:content";

// --- 路径生成 ---
export async function getStaticPaths() {
  const posts = await getCollection("post");
  
  const allTags = new Set<string>();
  
  // 收集所有唯一的标签
  posts.forEach(post => {
    if (post.data.tags && Array.isArray(post.data.tags)) {
      post.data.tags.forEach(tag => {
        const trimmedTag = tag.trim();
        if (trimmedTag) {
          allTags.add(trimmedTag);
        }
      });
    }
  });
  
  // generateTagData 负责将英文标签转为小写，并编码中文标签
  const allTagsData = generateTagData(allTags); 

  // 返回的 params.tag 已经是最终的 URL slug
  return allTagsData.map(tagItem => ({
    params: { tag: tagItem.slug }, 
    props: { rawTagTitle: tagItem.title }
  }));
}

// --- 页面内容获取 ---
const { tag: encodedTag } = Astro.params;
const { rawTagTitle } = Astro.props; 

// 显示给用户的标签标题 (解码后的原始标题)
const tagToFilterForDisplay = decodeURIComponent(encodedTag) || rawTagTitle; 
// 内部匹配使用的标准化小写标签
const tagToFilterNormalized = tagToFilterForDisplay.trim().toLowerCase(); 

const allPosts = await getCollection("post");
const taggedPosts = allPosts
  .filter(post => 
    post.data.tags && 
    Array.isArray(post.data.tags) && 
    // 过滤时，对比 post 中的标准化标签 (实现大小写不敏感匹配)
    post.data.tags.some(postTag => postTag.trim().toLowerCase() === tagToFilterNormalized)
  )
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const hasBlogPosts = taggedPosts.length > 0;
const hasWorks = false; 
---

<PageLayout title={`${tagToFilterForDisplay} - 标签`} description={`包含标签 "${tagToFilterForDisplay}" 的文章`}>
  <div class="relative site-container z-20 w-full mx-auto mt-8 px-4 md:mt-10 lg:mt-12 xl:px-0">
    <div class="text-center mb-8">
      <h1 class="text-5xl font-bold mb-4 tracking-tight text-gray-900 dark:text-gray-50">标签: {tagToFilterForDisplay}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {taggedPosts.length} 篇相关文章
      </p>
    </div>

    {hasBlogPosts && (
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 border-b pb-2 border-gray-200 dark:border-gray-700">相关文章</h2>
        <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
          {taggedPosts.map((post, index) => (
            <FeatureCard
              content={{ ...post.data, ...post } as any}
              data-aos={Math.floor(index / 3) % 2 === 0 ? "fade-right-sm" : "fade-left-sm"}
              data-aos-delay={((index % 3) + 1) * 200}
            />
          ))}
        </div>
      </section>
    )}
    
    {!hasBlogPosts && (
      <div class="text-center text-gray-500 dark:text-gray-400 py-12">
        <p>未找到包含标签 "{tagToFilterForDisplay}" 的内容。</p>
      </div>
    )}
  </div>
</PageLayout>

