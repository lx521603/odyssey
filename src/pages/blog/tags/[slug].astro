---
// 路径修复: 导入 src/layouts/base.astro 并使用 Base 组件
import Base from "@/layouts/base.astro"; 
import BlogCard from "@/components/cards/BlogCard.astro";
import WorkCard from "@/components/cards/WorkCard.astro";
import { getCollection } from "astro:content";
import works from "@/collections/featuredwork.json"; 
// 路径修复：使用路径别名 @/utils/helpers.js
import { generateTagData } from '@/utils/helpers.js'; 

// --- 路径生成 ---
export async function getStaticPaths() {
  const posts = await getCollection("post");
  
  const allTags = new Set<string>();
  
  posts.forEach(post => {
    if (post.data.tags && Array.isArray(post.data.tags)) {
      post.data.tags.forEach(tag => allTags.add(tag));
    }
  });
  
  works.forEach((work: any) => { 
    if (work.tags && Array.isArray(work.tags) && work.isShow !== false) {
      work.tags.forEach(tag => allTags.add(tag));
    }
  });
  
  const allTagsData = generateTagData(allTags); // 使用修复后的函数

  return allTagsData.map(tagItem => ({
    // 关键修复：使用 generateTagData 生成的编码后的 slug
    params: { tag: tagItem.slug }, 
    // props 传递原始标签名 (title)
    props: { rawTagTitle: tagItem.title }
  }));
}

// --- 页面内容获取 ---
const { tag: encodedTag } = Astro.params;
const { rawTagTitle } = Astro.props; // 获取原始标签名

// 确保用于过滤的标签是解码后的原始标签名
const tagToFilter = decodeURIComponent(encodedTag) || rawTagTitle; 

const allPosts = await getCollection("post");
const taggedPosts = allPosts
  .filter(post => post.data.tags && Array.isArray(post.data.tags) && post.data.tags.includes(tagToFilter))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const taggedWorks = works
  .filter(work => work.tags && Array.isArray(work.tags) && work.tags.includes(tagToFilter) && work.isShow !== false);

const hasBlogPosts = taggedPosts.length > 0;
const hasWorks = taggedWorks.length > 0;
---

<Base title={`${tagToFilter} - 标签`} description={`包含标签 "${tagToFilter}" 的文章和作品`}>
  <div class="relative site-container z-20 w-full mx-auto mt-8 px-4 md:mt-10 lg:mt-12 xl:px-0">
    <div class="text-center mb-8">
      <h1 class="text-5xl font-bold mb-4 tracking-tight text-gray-900 dark:text-gray-50">标签: {tagToFilter}</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400">
        {taggedPosts.length + taggedWorks.length} 个包含标签 "{tagToFilter}" 的内容
        {hasBlogPosts && hasWorks && ` (${taggedPosts.length} 篇文章, ${taggedWorks.length} 个作品)`}
        {hasBlogPosts && !hasWorks && ` (${taggedPosts.length} 篇文章)`}
        {!hasBlogPosts && hasWorks && ` (${taggedWorks.length} 个作品)`}
      </p>
    </div>

    {hasBlogPosts && (
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 border-b pb-2 border-gray-200 dark:border-gray-700">相关文章</h2>
        <div class="grid gap-x-6 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
          {taggedPosts.map((post, index) => (
            <BlogCard
              content={{ ...post.data, ...post } as any}
              data-aos={Math.floor(index / 3) % 2 === 0 ? "fade-right-sm" : "fade-left-sm"}
              data-aos-delay={((index % 3) + 1) * 200}
            />
          ))}
        </div>
      </section>
    )}

    {hasWorks && (
      <section class="mb-12">
        <h2 class="text-3xl font-bold mb-6 border-b pb-2 border-gray-200 dark:border-gray-700">相关作品</h2>
        <div class="space-y-8 md:space-y-10">
          {taggedWorks.map((work, index) => (
            <WorkCard
              name={work.name}
              description={work.description}
              image={work.image}
              url={work.url}
              tags={work.tags}
              video={(work as any).video ?? undefined} 
              isShow={work.isShow}
              layout="featured"
              index={index}
              mediaRatio="auto"
            />
          ))}
        </div>
      </section>
    )}

    {!hasBlogPosts && !hasWorks && (
      <div class="text-center text-gray-500 dark:text-gray-400 py-12">
        <p>未找到包含标签 "{tagToFilter}" 的内容。</p>
      </div>
    )}
  </div>
</Base>

