---
import settings from '../../../config/settings';
// 保持原有的其他导入
---

<!-- 保持原有的hero内容 -->

<!-- 主题切换器部分 -->
{settings.enableThemeSwitcher && (
  <div>
    <!-- 不使用client:only，直接渲染HTML -->
    <div class="theme-switcher__container">
      <div class="theme-select__container">
        <button>Classic</button>
        <p>Classic</p>
      </div>
      <div class="theme-select__container">
        <button>Dark</button>
        <p>Dark</p>
      </div>
      <div class="theme-select__container">
        <button>Earth</button>
        <p>Earth</p>
      </div>
      <div class="theme-select__container">
        <button>Ocean</button>
        <p>Ocean</p>
      </div>
      <div class="theme-select__container">
        <button>Sand</button>
        <p>Sand</p>
      </div>
    </div>
    
    <!-- 添加内联脚本来处理主题切换 -->
    <script is:inline>
      // 主题切换逻辑
      function setTheme(theme) {
        const doc = document.firstElementChild;
        doc.setAttribute('data-theme', theme);
        
        const heroImage = document.querySelector('#home-hero-image');
        if (heroImage) {
          const images = {
            'default': '/assets/images/home/classic-hero.jpg',
            'dark': '/assets/images/home/dark-hero.jpg', 
            'earth': '/assets/images/home/earth-hero.jpg',
            'ocean': '/assets/images/home/ocean-hero.jpg',
            'sand': '/assets/images/home/sand-hero.jpg'
          };
          heroImage.src = images[theme] || images['default'];
        }
        
        localStorage.setItem('theme', theme);
      }
      
      // 初始化主题
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme) {
        setTheme(savedTheme);
      } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
        setTheme('dark');
      }
      
      // 为按钮添加点击事件
      document.addEventListener('DOMContentLoaded', function() {
        const buttons = document.querySelectorAll('.theme-select__container button');
        buttons.forEach((button, index) => {
          const themes = ['default', 'dark', 'earth', 'ocean', 'sand'];
          button.addEventListener('click', () => setTheme(themes[index]));
        });
      });
    </script>
  </div>
)}
